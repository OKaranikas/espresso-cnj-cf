FUNCTION CNJ_WITZSTATISTIK ()
RETURNS TABLE (
  QUELLE_ID    NVARCHAR(36),
  ANZAHL       BIGINT,
  DURCHSCHNITT DECIMAL(10,2)
)
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
READS SQL DATA
AS
BEGIN
  RETURN SELECT QUELLE_ID,
                COUNT(*) AS ANZAHL,
                CAST(AVG(BEWERTUNG) AS DECIMAL(10,2)) AS DURCHSCHNITT
           FROM CNJ_WITZ
          GROUP BY QUELLE_ID;
END
