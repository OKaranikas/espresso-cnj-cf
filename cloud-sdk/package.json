{
  "name": "@espresso/cnj-cloud-sdk",
  "version": "1.0.0",
  "description": "Typisierte OData-Clients und Integrationscode auf Basis des SAP Cloud SDK for JavaScript",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "generate-odata-client --input ./edmx --outputDir ./src/generated --optionsPerService ./edmx/options-per-service.json --overwrite",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check-versions": "node ../zentrale-komponenten/check-versions.js"
  },
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/odata-v4": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap-cloud-sdk/util": "^4"
  },
  "devDependencies": {
    "@sap-cloud-sdk/generator": "^4",
    "@sap-cloud-sdk/test-util": "^4",
    "@types/jest": "^29",
    "@types/node": "^22",
    "jest": "^29",
    "nock": "^13",
    "ts-jest": "^29",
    "typescript": "^5"
  }
}
