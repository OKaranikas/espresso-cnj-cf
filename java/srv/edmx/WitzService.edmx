<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Capabilities.V1.xml">
    <edmx:Include Alias="Capabilities" Namespace="Org.OData.Capabilities.V1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Alias="UI" Namespace="com.sap.vocabularies.UI.v1"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="WitzService" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Annotation Term="Core.Links">
        <Collection>
          <Record>
            <PropertyValue Property="rel" String="author"/>
            <PropertyValue Property="href" String="https://cap.cloud.sap"/>
          </Record>
        </Collection>
      </Annotation>
      <EntityContainer Name="EntityContainer">
        <EntitySet Name="Witze" EntityType="WitzService.Witze">
          <NavigationPropertyBinding Path="kategorie" Target="Kategorien"/>
          <NavigationPropertyBinding Path="quelle" Target="Quellen"/>
          <NavigationPropertyBinding Path="texts" Target="Witze_texts"/>
          <NavigationPropertyBinding Path="localized" Target="Witze_texts"/>
        </EntitySet>
        <EntitySet Name="Quellen" EntityType="WitzService.Quellen">
          <NavigationPropertyBinding Path="witze" Target="Witze"/>
        </EntitySet>
        <EntitySet Name="Kategorien" EntityType="WitzService.Kategorien">
          <NavigationPropertyBinding Path="texts" Target="Kategorien_texts"/>
          <NavigationPropertyBinding Path="localized" Target="Kategorien_texts"/>
        </EntitySet>
        <EntitySet Name="Statistik" EntityType="WitzService.Statistik"/>
        <EntitySet Name="Witze_texts" EntityType="WitzService.Witze_texts"/>
        <EntitySet Name="Kategorien_texts" EntityType="WitzService.Kategorien_texts"/>
        <ActionImport Name="witzAbrufen" Action="WitzService.witzAbrufen" EntitySet="Witze"/>
      </EntityContainer>
      <EntityType Name="Witze">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="createdBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="modifiedBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="text" Type="Edm.String" MaxLength="5000" Nullable="false"/>
        <Property Name="apiId" Type="Edm.String" MaxLength="255"/>
        <Property Name="bewertung" Type="Edm.Int32"/>
        <NavigationProperty Name="kategorie" Type="WitzService.Kategorien">
          <ReferentialConstraint Property="kategorie_code" ReferencedProperty="code"/>
        </NavigationProperty>
        <Property Name="kategorie_code" Type="Edm.String" MaxLength="20"/>
        <NavigationProperty Name="quelle" Type="WitzService.Quellen" Partner="witze">
          <ReferentialConstraint Property="quelle_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="quelle_ID" Type="Edm.Guid"/>
        <NavigationProperty Name="texts" Type="Collection(WitzService.Witze_texts)">
          <OnDelete Action="Cascade"/>
        </NavigationProperty>
        <NavigationProperty Name="localized" Type="WitzService.Witze_texts">
          <ReferentialConstraint Property="ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="istTopWitz" Type="Edm.Boolean"/>
      </EntityType>
      <EntityType Name="Quellen">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="createdBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="modifiedBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="name" Type="Edm.String" MaxLength="100" Nullable="false"/>
        <Property Name="url" Type="Edm.String" MaxLength="255"/>
        <NavigationProperty Name="witze" Type="Collection(WitzService.Witze)" Partner="quelle"/>
      </EntityType>
      <EntityType Name="Kategorien">
        <Key>
          <PropertyRef Name="code"/>
        </Key>
        <Property Name="name" Type="Edm.String" MaxLength="255"/>
        <Property Name="descr" Type="Edm.String" MaxLength="1000"/>
        <Property Name="code" Type="Edm.String" MaxLength="20" Nullable="false"/>
        <NavigationProperty Name="texts" Type="Collection(WitzService.Kategorien_texts)">
          <OnDelete Action="Cascade"/>
        </NavigationProperty>
        <NavigationProperty Name="localized" Type="WitzService.Kategorien_texts">
          <ReferentialConstraint Property="code" ReferencedProperty="code"/>
        </NavigationProperty>
      </EntityType>
      <EntityType Name="Statistik">
        <Key>
          <PropertyRef Name="quelle_ID"/>
        </Key>
        <Property Name="quelle_ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="anzahl" Type="Edm.Int64"/>
        <Property Name="durchschnittsbewertung" Type="Edm.Decimal" Precision="10" Scale="2"/>
      </EntityType>
      <EntityType Name="Witze_texts">
        <Key>
          <PropertyRef Name="locale"/>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="locale" Type="Edm.String" MaxLength="14" Nullable="false"/>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="text" Type="Edm.String" MaxLength="5000" Nullable="false"/>
      </EntityType>
      <EntityType Name="Kategorien_texts">
        <Key>
          <PropertyRef Name="locale"/>
          <PropertyRef Name="code"/>
        </Key>
        <Property Name="locale" Type="Edm.String" MaxLength="14" Nullable="false"/>
        <Property Name="name" Type="Edm.String" MaxLength="255"/>
        <Property Name="descr" Type="Edm.String" MaxLength="1000"/>
        <Property Name="code" Type="Edm.String" MaxLength="20" Nullable="false"/>
      </EntityType>
      <Action Name="bewertungAnpassen" IsBound="true">
        <Parameter Name="in" Type="WitzService.Quellen"/>
        <Parameter Name="prozent" Type="Edm.Decimal" Precision="5" Scale="2"/>
      </Action>
      <Action Name="witzAbrufen" IsBound="false">
        <ReturnType Type="WitzService.Witze"/>
      </Action>
      <Annotations Target="WitzService.Witze/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="WitzService.Witze/createdAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedAt}"/>
      </Annotations>
      <Annotations Target="WitzService.Witze/createdBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedBy}"/>
      </Annotations>
      <Annotations Target="WitzService.Witze/modifiedAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedAt}"/>
      </Annotations>
      <Annotations Target="WitzService.Witze/modifiedBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedBy}"/>
      </Annotations>
      <Annotations Target="WitzService.Witze/text">
        <Annotation Term="Common.Label" String="{i18n>Text}"/>
      </Annotations>
      <Annotations Target="WitzService.Witze/kategorie_code">
        <Annotation Term="Common.ValueList">
          <Record Type="Common.ValueListType">
            <PropertyValue Property="Label" String="Kategorien"/>
            <PropertyValue Property="CollectionPath" String="Kategorien"/>
            <PropertyValue Property="Parameters">
              <Collection>
                <Record Type="Common.ValueListParameterInOut">
                  <PropertyValue Property="LocalDataProperty" PropertyPath="kategorie_code"/>
                  <PropertyValue Property="ValueListProperty" String="code"/>
                </Record>
                <Record Type="Common.ValueListParameterDisplayOnly">
                  <PropertyValue Property="ValueListProperty" String="name"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
      </Annotations>
      <Annotations Target="WitzService.Witze/istTopWitz">
        <Annotation Term="Core.Computed" Bool="true"/>
      </Annotations>
      <Annotations Target="WitzService.Quellen/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="WitzService.Quellen/createdAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedAt}"/>
      </Annotations>
      <Annotations Target="WitzService.Quellen/createdBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedBy}"/>
      </Annotations>
      <Annotations Target="WitzService.Quellen/modifiedAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedAt}"/>
      </Annotations>
      <Annotations Target="WitzService.Quellen/modifiedBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedBy}"/>
      </Annotations>
      <Annotations Target="WitzService.Kategorien">
        <Annotation Term="UI.Identification">
          <Collection>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="name"/>
            </Record>
          </Collection>
        </Annotation>
      </Annotations>
      <Annotations Target="WitzService.EntityContainer/Kategorien">
        <Annotation Term="Capabilities.DeleteRestrictions">
          <Record Type="Capabilities.DeleteRestrictionsType">
            <PropertyValue Property="Deletable" Bool="false"/>
          </Record>
        </Annotation>
        <Annotation Term="Capabilities.InsertRestrictions">
          <Record Type="Capabilities.InsertRestrictionsType">
            <PropertyValue Property="Insertable" Bool="false"/>
          </Record>
        </Annotation>
        <Annotation Term="Capabilities.UpdateRestrictions">
          <Record Type="Capabilities.UpdateRestrictionsType">
            <PropertyValue Property="Updatable" Bool="false"/>
          </Record>
        </Annotation>
      </Annotations>
      <Annotations Target="WitzService.Kategorien/name">
        <Annotation Term="Common.Label" String="{i18n>Name}"/>
      </Annotations>
      <Annotations Target="WitzService.Kategorien/descr">
        <Annotation Term="Common.Label" String="{i18n>Description}"/>
      </Annotations>
      <Annotations Target="WitzService.EntityContainer/Statistik">
        <Annotation Term="Capabilities.DeleteRestrictions">
          <Record Type="Capabilities.DeleteRestrictionsType">
            <PropertyValue Property="Deletable" Bool="false"/>
          </Record>
        </Annotation>
        <Annotation Term="Capabilities.InsertRestrictions">
          <Record Type="Capabilities.InsertRestrictionsType">
            <PropertyValue Property="Insertable" Bool="false"/>
          </Record>
        </Annotation>
        <Annotation Term="Capabilities.UpdateRestrictions">
          <Record Type="Capabilities.UpdateRestrictionsType">
            <PropertyValue Property="Updatable" Bool="false"/>
          </Record>
        </Annotation>
      </Annotations>
      <Annotations Target="WitzService.Statistik/quelle_ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="WitzService.Witze_texts/locale">
        <Annotation Term="Common.Label" String="{i18n>LanguageCode}"/>
      </Annotations>
      <Annotations Target="WitzService.Witze_texts/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="WitzService.Witze_texts/text">
        <Annotation Term="Common.Label" String="{i18n>Text}"/>
      </Annotations>
      <Annotations Target="WitzService.Kategorien_texts/locale">
        <Annotation Term="Common.Label" String="{i18n>LanguageCode}"/>
      </Annotations>
      <Annotations Target="WitzService.Kategorien_texts/name">
        <Annotation Term="Common.Label" String="{i18n>Name}"/>
      </Annotations>
      <Annotations Target="WitzService.Kategorien_texts/descr">
